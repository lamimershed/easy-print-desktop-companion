# Dependencies
node_modules/

# Build outputs
dist/
out/

# NOT build/ — that is electron-builder's resources directory, not an output.
# Ignoring it left build/icon.ico untracked while package.json pointed the
# Windows target at it, so a clean clone could not produce an installer with
# the right icon.

# Electron
.electron/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.local
.env.*.local

# Agent/tooling scratch dirs
.playwright-mcp/
.superpowers/

# Written by SumatraPDF each time it runs; must not ship in the installer
vendor/win/SumatraPDF-settings.txt
