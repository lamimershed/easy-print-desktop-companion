{
  "name": "cafe-app",
  "version": "1.0.0",
  "description": "Simple Electron print app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "dotenv": "^17.3.1"
  },
  "build": {
    "appId": "com.easyprint.companion",
    "productName": "Print Easy",
    "mac": {
      "icon": "build/icon.icns",
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      ".env"
    ]
  }
}
