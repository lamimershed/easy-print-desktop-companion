{
  "name": "cafe-app",
  "version": "1.1.0",
  "description": "Simple Electron print app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:win:download": "bash scripts/build-win.sh"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "net-snmp": "^3.11.2"
  },
  "build": {
    "appId": "com.easyprint.companion",
    "productName": "Print Easy",
    "mac": {
      "icon": "build/icon.icns",
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      ".env.production"
    ],
    "extraResources": [
      {
        "from": "vendor/win",
        "to": "vendor/win",
        "filter": [
          "**/*",
          "!SumatraPDF-settings.txt"
        ]
      }
    ]
  }
}
